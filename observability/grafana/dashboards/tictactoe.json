{
 "uid": "tictactoe",
 "title": "Tic Tac Toe",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "title": "Games started",
   "type": "stat",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service=~\"game.*\"} | json | event=\"game_start\" [$__range]))",
     "refId": "A",
     "queryType": "instant"
    }
   ]
  },
  {
   "id": 2,
   "title": "Games finished",
   "type": "stat",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service=~\"game.*\"} | json | event=\"game_end\" [$__range]))",
     "refId": "A",
     "queryType": "instant"
    }
   ]
  },
  {
   "id": 3,
   "title": "Unique visitors",
   "type": "stat",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "count(sum by (visitor) (count_over_time({service=~\"game.*\"} | json | visitor!=\"\" [$__range])))",
     "refId": "A",
     "queryType": "instant"
    }
   ]
  },
  {
   "id": 4,
   "title": "Events logged",
   "type": "stat",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({service=~\"game.*\"} | json | event!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant"
    }
   ]
  },
  {
   "id": 5,
   "title": "Events over time",
   "type": "timeseries",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (event) (count_over_time({service=~\"game.*\"} | json | event!=\"\" [$__interval]))",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "{{event}}"
    }
   ]
  },
  {
   "id": 6,
   "title": "Results",
   "type": "piechart",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (result) (count_over_time({service=~\"game.*\"} | json | event=\"game_end\" | result!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant",
     "legendFormat": "{{result}}"
    }
   ]
  },
  {
   "id": 7,
   "title": "Games by mode",
   "type": "piechart",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (mode) (count_over_time({service=~\"game.*\"} | json | event=\"game_start\" | mode!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 8,
   "title": "AI difficulty",
   "type": "piechart",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (level) (count_over_time({service=~\"game.*\"} | json | event=\"game_start\" | level!=\"\" [$__range]))",
     "refId": "A",
     "queryType": "instant",
     "legendFormat": "{{level}}"
    }
   ]
  },
  {
   "id": 9,
   "title": "Live game logs",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=~\"game.*\"}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}