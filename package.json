{
  "name": "tictactoe",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/server.js",
    "dev": "npm run build && node --watch server/server.ts",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ioredis": "^5.4.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
